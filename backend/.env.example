# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/paralisetu

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_BEFORE_COMMIT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OTP (Firebase or MSG91) ────────────────────────────────────────────────
OTP_PROVIDER=firebase          # firebase | msg91
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
MSG91_AUTH_KEY=

# ── Demo / Dev Mode ───────────────────────────────────────────────────────────
DEBUG=false                    # Set to true for local debugging. When false (production), JWT_SECRET_KEY must not be a placeholder.
DEMO_MODE=false                # false by default. When true, code 123456 is accepted ONLY for DEMO_PHONES.
DEMO_PHONES=+919810000001,+919810000002  # Comma-separated E.164 numbers allowed to use demo OTP 123456 in demo mode.


# ── Payment (MockPaymentProvider for hackathon) ────────────────────────────
PAYMENT_PROVIDER=mock           # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Satellite / FIRMS ─────────────────────────────────────────────────────
FIRMS_MAP_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
LLAMA_URL=http://localhost:8080/v1   # llama-server or ONNX runtime endpoint
SIMSAT_URL=

# ── Voice / ASR ───────────────────────────────────────────────────────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── OSRM (routing for matching engine) ────────────────────────────────────
OSRM_BASE_URL=http://router.project-osrm.org

# ── Notifications ─────────────────────────────────────────────────────────
MSG91_SMS_AUTH_KEY=
FIREBASE_FCM_SERVER_KEY=
